{
  "name": "anthropometry",
  "version": "0.1.0",
  "homepage": "https://anthropometry.sebastian-gomez.com",
  "private": true,
  "dependencies": {
    "@auth0/auth0-react": "^2.22.0",
    "@auth0/auth0-spa-js": "^2.24.0",
    "@blackbox-vision/ra-language-spanish": "^4.11.3",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "@mui/styled-engine-sc": "^9.1.1",
    "@mui/x-date-pickers": "^9.10.1",
    "@react-pdf/renderer": "^4.5.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "chart.js": "^4.5.1",
    "graphql": "^17.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "ra-data-hasura": "^0.7.1",
    "react": "^19.2.8",
    "react-admin": "^5.15.1",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "4.5.0",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "styled-components": "^6.4.4",
    "web-vitals": "^6.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "e2e": "cypress open",
    "lint": "eslint src",
    "config:features": "node scripts/configure-features.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {}
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "cypress": "^15.19.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "react-hotkeys-hook": "4.5.0"
  }
}
