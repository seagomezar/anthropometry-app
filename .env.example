# =====================================================================
# ANTHROPOMETRY APP ENVIRONMENT CONFIGURATION
# Copy this file to '.env' in the project root and populate as needed.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Hasura GraphQL Backend Configuration
# ---------------------------------------------------------------------
# Hasura GraphQL Endpoint URL (Defaults to https://nutrition-app.hasura.app/v1/graphql if omitted)
REACT_APP_HASURA_GRAPHQL_URL=https://nutrition-app.hasura.app/v1/graphql

# Hasura Admin Secret / API Key
# If your Hasura instance requires an admin secret header, set it here.
# Leave empty if your Hasura instance allows unauthenticated / anonymous queries.
REACT_APP_HASURA_ADMIN_SECRET=

# Alternative key names supported for backwards compatibility:
# REACT_APP_HASURA_API_KEY=
# REACT_APP_HASHURA_API_KEY=


# ---------------------------------------------------------------------
# 2. Authentication (Auth0) Configuration
# ---------------------------------------------------------------------
# Set to 'true' to enable Auth0 login page and authentication checks.
# Set to 'false' (or omit) to bypass login for local testing.
REACT_APP_ENABLE_LOGIN=false

# Auth0 Tenant Domain (Required if REACT_APP_ENABLE_LOGIN is true)
# Example: your-tenant.us.auth0.com
REACT_APP_AUTH0_DOMAIN=

# Auth0 Client Application ID (Required if REACT_APP_ENABLE_LOGIN is true)
REACT_APP_AUTH0_CLIENT_ID=

# Auth0 Callback / Redirect URI
REACT_APP_AUTH0_REDIRECT_URI=http://localhost:3000
